# DPNR Production Environment Template
# Copy this file to .env.production and fill in actual values

# ===========================================
# DATABASE CONFIGURATION - Choose One Option
# ===========================================

# Option A: Vercel Postgres (Recommended for Vercel deployment)
DATABASE_URL="postgres://default:PASSWORD@POOLER_URL.postgres.vercel-storage.com:5432/verceldb"

# Option B: Supabase (Good PostgreSQL service with additional features)
# DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT_ID.supabase.co:5432/postgres"

# Option C: Railway (Simple and affordable)
# DATABASE_URL="postgresql://postgres:PASSWORD@HOSTNAME.railway.app:5432/railway"

# Option D: AWS RDS (Enterprise-grade)
# DATABASE_URL="postgresql://dpnr_user:PASSWORD@dpnr-db.INSTANCE_ID.us-east-1.rds.amazonaws.com:5432/dpnr_prod"

# Option E: Digital Ocean Managed Database
# DATABASE_URL="postgresql://doadmin:PASSWORD@dpnr-db-do-user-123456-0.b.db.ondigitalocean.com:25060/dpnr_prod?sslmode=require"

# ===========================================
# SERVER CONFIGURATION
# ===========================================
NODE_ENV=production
PORT=3001
API_BASE_URL=https://api.your-domain.com/v1

# ===========================================
# AWS CONFIGURATION
# ===========================================
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...

# AWS Cognito
AWS_COGNITO_USER_POOL_ID=eu-west-1_...
AWS_COGNITO_CLIENT_ID=...
AWS_COGNITO_CLIENT_SECRET=...

# AWS SES (for production emails)
AWS_SES_FROM_EMAIL=noreply@be-dpnr.com
AWS_SES_REGION=eu-west-1

# ===========================================
# PAYMENT CONFIGURATION
# ===========================================
TRANZILA_TERMINAL=your-production-terminal-id
TRANZILA_API_KEY=your-production-api-key
TRANZILA_CURRENCY=ILS
TRANZILA_MODE=production
TRANZILA_WEBHOOK_URL=https://api.your-domain.com/v1/payments/webhook

# ===========================================
# SECURITY CONFIGURATION
# ===========================================
JWT_SECRET=your-production-jwt-secret-at-least-32-characters-long
JWT_EXPIRY=24h
JWT_REFRESH_SECRET=your-production-refresh-secret-different-from-jwt
JWT_REFRESH_EXPIRY=7d

WEBHOOK_SECRET=your-production-webhook-secret
COOKIE_SECRET=your-production-cookie-secret
GOOGLE_RECAPTCHA_SECRET_KEY=...

# ===========================================
# CORS AND SECURITY
# ===========================================
CORS_ORIGIN=https://your-domain.com
COOKIE_SECURE=true
COOKIE_HTTP_ONLY=true

# ===========================================
# EMAIL CONFIGURATION
# ===========================================
# Option A: AWS SES (Recommended)
SMTP_HOST=email-smtp.eu-west-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=your-ses-smtp-username
SMTP_PASS=your-ses-smtp-password

# Option B: SendGrid
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key

# Option C: Gmail (not recommended for production)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

FROM_EMAIL=noreply@be-dpnr.com
FROM_NAME="DPNR Program"
EMAIL_TEMPLATE_DIR=src/templates

# ===========================================
# REDIS CONFIGURATION
# ===========================================
# Option A: Vercel KV (if using Vercel)
# REDIS_URL=redis://default:PASSWORD@HOSTNAME.kv.vercel-storage.com:PORT

# Option B: Railway Redis
# REDIS_URL=redis://default:PASSWORD@HOSTNAME.railway.app:PORT

# Option C: AWS ElastiCache
# REDIS_URL=redis://dpnr-cache.CLUSTER_ID.cache.amazonaws.com:6379

# Option D: Redis Cloud
REDIS_URL=redis://default:PASSWORD@HOSTNAME.redislabs.com:PORT

# ===========================================
# RATE LIMITING
# ===========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# FILE UPLOAD
# ===========================================
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads

# ===========================================
# LOGGING AND MONITORING
# ===========================================
LOG_LEVEL=warn
LOG_FILE=logs/app.log

# Sentry for error tracking
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# New Relic for performance monitoring
NEW_RELIC_LICENSE_KEY=your-newrelic-license-key

# Google Analytics
ANALYTICS_API_KEY=your-analytics-key

# ===========================================
# GDPR COMPLIANCE
# ===========================================
DATA_RETENTION_DAYS=2555
BACKUP_RETENTION_DAYS=90

# ===========================================
# FEATURE FLAGS
# ===========================================
ENABLE_REGISTRATION=true
ENABLE_CONSULTATIONS=true
ENABLE_PAYMENTS=true
ENABLE_EMAIL_NOTIFICATIONS=true

# ===========================================
# DEVELOPMENT TOOLS (disable in production)
# ===========================================
PRISMA_STUDIO_PORT=5555