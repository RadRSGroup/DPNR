# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001/v1
NEXT_PUBLIC_API_TIMEOUT=10000

# AWS Cognito Configuration
NEXT_PUBLIC_AWS_REGION=eu-west-1
NEXT_PUBLIC_COGNITO_USER_POOL_ID=your-user-pool-id
NEXT_PUBLIC_COGNITO_CLIENT_ID=your-client-id
NEXT_PUBLIC_COGNITO_IDENTITY_POOL_ID=your-identity-pool-id

# Tranzila Configuration
NEXT_PUBLIC_TRANZILA_TERMINAL=your-terminal-id
NEXT_PUBLIC_TRANZILA_MODE=test

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="DPNR - Personal Development Program"
NEXT_PUBLIC_CONTACT_EMAIL=info@be-dpnr.com
NEXT_PUBLIC_PHONE=+972-50-123-4567

# Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_HOTJAR_ID=123456
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=123456789

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_CHAT=false
NEXT_PUBLIC_ENABLE_TESTIMONIALS=false
NEXT_PUBLIC_ENABLE_BLOG=false

# Content
NEXT_PUBLIC_DEFAULT_LOCALE=he
NEXT_PUBLIC_SUPPORTED_LOCALES=he,en

# Social Media
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/dpnr
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/dpnr
