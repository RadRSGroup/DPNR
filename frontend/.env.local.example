# reCAPTCHA
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-site-key

# Development
NEXT_PUBLIC_DEV_MODE=true
NEXT_PUBLIC_SHOW_DEBUG=false

# CDN
NEXT_PUBLIC_CDN_URL=https://cdn.be-dpnr.com

# Payment
NEXT_PUBLIC_CURRENCY=ILS
NEXT_PUBLIC_PAYMENT_SUCCESS_URL=/enrollment/success
NEXT_PUBLIC_PAYMENT_CANCEL_URL=/enrollment/cancel

# Course Information
