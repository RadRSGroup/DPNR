{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true,
    "baseUrl": ".",
    "allowJs": true,
    "incremental": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "components/3d/**",
    "components/3dplan_alt/**",
    "app/beautiful-grove/**",
    "app/deeper-tree-journey/**",
    "app/demo-celshaded/**",
    "app/depth-tree/**",
    "app/forest-stream/**",
    "app/image-tree/**",
    "app/mystical-grove/**",
    "app/simple-tree/**",
    "app/smooth-tree/**",
    "app/tree-journey/**",
    "app/tree-sprite/**"
  ]
}
