// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(uuid())
  cognitoId         String   @unique
  email             String   @unique
  firstName         String
  lastName          String
  phone             String?
  preferredLanguage Language @default(HE)
  role              UserRole @default(STUDENT)
  emailVerified     Boolean  @default(false)
  phoneVerified     Boolean  @default(false)
  mfaEnabled        Boolean  @default(false)
  lastLoginAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  // Relations
  enrollments         Enrollment[]
  consultationRequests ConsultationRequest[]
  privacyConsents     PrivacyConsent[]

  @@map("users")
}

model Cohort {
  id                String       @id @default(uuid())
  name              String       @unique
  startDate         DateTime
  endDate           DateTime
  maxCapacity       Int          @default(20)
  currentEnrollment Int          @default(0)
  status            CohortStatus @default(UPCOMING)
  location          String       @default("Mazkeret Batya")
  schedule          String       @default("Weekly evenings, 1.5-2 hours")
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  // Relations
  enrollments Enrollment[]

  @@map("cohorts")
}

model Enrollment {
  id             String           @id @default(uuid())
  userId         String
  cohortId       String
  status         EnrollmentStatus @default(PENDING_PAYMENT)
  paymentPlan    PaymentPlan
  totalAmount    Decimal          @db.Decimal(10, 2)
  paidAmount     Decimal          @default(0) @db.Decimal(10, 2)
  enrollmentDate DateTime         @default(now())
  questionnaire  Json
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // Relations
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  cohort             Cohort               @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  paymentTransactions PaymentTransaction[]

  @@unique([userId, cohortId])
  @@map("enrollments")
}

model ConsultationRequest {
  id                String          @id @default(uuid())
  firstName         String
  lastName          String
  email             String          @unique
  phone             String
  preferredLanguage Language        @default(HE)
  preferredTimeSlot String
  message           String?
  status            RequestStatus   @default(NEW)
  userId            String?
  createdAt         DateTime        @default(now())
  processedAt       DateTime?

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("consultation_requests")
}

model PaymentTransaction {
  id                 String            @id @default(uuid())
  enrollmentId       String
  tranzillaReference String            @unique
  amount             Decimal           @db.Decimal(10, 2)
  installmentNumber  Int?
  status             TransactionStatus @default(PENDING)
  paymentMethod      String
  failureReason      String?
  processedAt        DateTime          @default(now())
  createdAt          DateTime          @default(now())

  // Relations
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@map("payment_transactions")
}

model PrivacyConsent {
  id          String      @id @default(uuid())
  userId      String
  consentType ConsentType
  granted     Boolean
  ipAddress   String
  userAgent   String
  version     String
  createdAt   DateTime    @default(now())
  revokedAt   DateTime?

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, consentType])
  @@map("privacy_consents")
}

// Enums
enum Language {
  HE
  EN
}

enum UserRole {
  STUDENT
  ADMIN
  INSTRUCTOR
}

enum EnrollmentStatus {
  PENDING_PAYMENT
  ACTIVE
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentPlan {
  FULL
  FIVE_INSTALLMENTS
  TWELVE_INSTALLMENTS
}

enum CohortStatus {
  UPCOMING
  OPEN_ENROLLMENT
  FULL
  IN_PROGRESS
  COMPLETED
}

enum RequestStatus {
  NEW
  CONTACTED
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum ConsentType {
  PRIVACY_POLICY
  TERMS_OF_SERVICE
  MARKETING_EMAILS
  ANALYTICS_COOKIES
}