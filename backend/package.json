{
  "name": "dpnr-backend",
  "version": "1.0.0",
  "description": "Backend API for DPNR Course Registration Platform",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon src/index.ts",
    "build": "tsc --skipLibCheck || true && node fix-build.js",
    "build:strict": "tsc",
    "start": "node start-production.js",
    "start:dev": "node dist/index.js",
    "test": "jest",
    "test:ci": "jest --ci --coverage --watchAll=false --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:contract": "jest tests/contract",
    "test:integration": "jest tests/integration",
    "test:unit": "jest tests/unit",
    "type-check": "tsc --noEmit",
    "package": "npm run build && zip -r dist/lambda-package.zip dist/ node_modules/",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:setup": "tsx src/scripts/setup-database.ts",
    "db:reset": "prisma migrate reset --force && tsx src/scripts/seed.ts",
    "db:deploy": "tsx src/scripts/deploy-database.ts",
    "db:deploy:staging": "tsx src/scripts/deploy-database.ts staging",
    "db:deploy:prod": "tsx src/scripts/deploy-database.ts production --skip-seed",
    "db:deploy:dry-run": "tsx src/scripts/deploy-database.ts staging --dry-run",
    "db:health": "tsx src/scripts/health-check.ts",
    "db:health:json": "tsx src/scripts/health-check.ts --json",
    "db:health:ci": "tsx src/scripts/health-check.ts --exit-on-failure",
    "db:init-migration": "tsx src/scripts/init-migration.ts",
    "validate:prod": "tsx src/scripts/validate-production.ts",
    "validate:prod:json": "tsx src/scripts/validate-production.ts --json",
    "validate:prod:ci": "tsx src/scripts/validate-production.ts --exit-on-failure",
    "lint": "eslint src/**/*.ts --max-warnings 0",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check src/**/*.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.893.0",
    "@prisma/client": "^5.22.0",
    "@supabase/supabase-js": "^2.57.4",
    "@types/node-fetch": "^2.6.13",
    "aws-jwt-verify": "^5.1.0",
    "aws-sdk": "^2.1490.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.2.0",
    "module-alias": "^2.2.3",
    "node-fetch": "^2.7.0",
    "nodemailer": "^6.9.7",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@sentry/node": "^7.118.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.9.0",
    "@types/nodemailer": "^6.4.14",
    "@types/supertest": "^2.0.16",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.1.0",
    "prisma": "^5.22.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.1.4",
    "typescript": "^5.2.2"
  },
  "keywords": [
    "api",
    "nodejs",
    "typescript",
    "express",
    "postgresql",
    "education",
    "course-registration"
  ],
  "author": "DPNR Development Team",
  "license": "MIT",
  "_moduleAliases": {
    "@": "./dist"
  }
}
