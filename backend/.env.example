# Database Configuration
DATABASE_URL="postgresql://username:password@hostname:5432/database_name?schema=public"

# For local development with Docker:
# DATABASE_URL="postgresql://dpnr_user:dpnr_password@localhost:5432/dpnr_dev?schema=public"

# For production examples:
# Vercel Postgres: DATABASE_URL="postgres://default:xxx@xxx-pooler.us-east-1.postgres.vercel-storage.com:5432/verceldb"
# Supabase: DATABASE_URL="postgresql://postgres:xxx@db.xxx.supabase.co:5432/postgres"
# Railway: DATABASE_URL="postgresql://postgres:xxx@xxx.railway.app:5432/railway"
# AWS RDS: DATABASE_URL="postgresql://dpnr_user:xxx@dpnr-db.xxx.us-east-1.rds.amazonaws.com:5432/dpnr_prod"

# Server Configuration
PORT=3001
NODE_ENV=development
API_BASE_URL=http://localhost:3001/v1

# AWS Configuration
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# AWS Cognito
AWS_COGNITO_USER_POOL_ID=your-user-pool-id
AWS_COGNITO_CLIENT_ID=your-client-id
AWS_COGNITO_CLIENT_SECRET=your-client-secret

# AWS SES
AWS_SES_FROM_EMAIL=noreply@be-dpnr.com
AWS_SES_REGION=eu-west-1

# Tranzila Payment Gateway
TRANZILA_TERMINAL=your-terminal-id
TRANZILA_API_KEY=your-api-key
TRANZILA_CURRENCY=ILS
TRANZILA_MODE=test
# For production, set TRANZILA_MODE=production
TRANZILA_WEBHOOK_URL=http://localhost:3001/v1/payments/webhook

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-for-development-change-in-production
JWT_EXPIRY=24h
JWT_REFRESH_SECRET=your-super-secret-refresh-jwt-key
JWT_REFRESH_EXPIRY=7d

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=noreply@be-dpnr.com
FROM_NAME="DPNR Program"

# For development with MailHog:
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=""
# SMTP_PASS=""

# Email Templates
EMAIL_TEMPLATE_DIR=src/templates

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Cookie Configuration
COOKIE_SECRET=your-cookie-secret-key
COOKIE_SECURE=false
COOKIE_HTTP_ONLY=true

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# External API Keys
GOOGLE_RECAPTCHA_SECRET_KEY=your-recaptcha-secret
ANALYTICS_API_KEY=your-analytics-key

# Redis Configuration (for sessions/caching)
REDIS_URL=redis://localhost:6379
# For production:
# REDIS_URL=redis://username:password@hostname:port

# Security
CORS_ORIGIN=http://localhost:3000
# For production, use actual frontend URL:
# CORS_ORIGIN=https://your-domain.com

# Webhook Security
WEBHOOK_SECRET=your-webhook-secret-for-tranzila

# GDPR Compliance
DATA_RETENTION_DAYS=2555
BACKUP_RETENTION_DAYS=90

# Feature Flags
ENABLE_REGISTRATION=true
ENABLE_CONSULTATIONS=true
ENABLE_PAYMENTS=true
ENABLE_EMAIL_NOTIFICATIONS=true

# Monitoring (if using external services)
SENTRY_DSN=https://your-sentry-dsn
NEW_RELIC_LICENSE_KEY=your-newrelic-key

# Development Tools
PRISMA_STUDIO_PORT=5555